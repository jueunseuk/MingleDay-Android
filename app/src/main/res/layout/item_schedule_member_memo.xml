<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/member_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/input_full"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginTop="6dp">

    <ImageView
        android:id="@+id/member_profile_image"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/image_alt"
        android:scaleType="centerCrop"
        android:src="@drawable/default_profile"
        android:background="@drawable/bg_circle"
        android:layout_gravity="center"
        android:clipToOutline="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/member_name_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/title"
            android:fontFamily="@font/semibold" />

        <TextView
            android:id="@+id/member_memo_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12sp"
            android:textColor="@color/content"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
