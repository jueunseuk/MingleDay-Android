<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/content"
        android:text="@string/password_description"
        android:layout_marginBottom="70dp"/>

    <LinearLayout
        android:id="@+id/input_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">
            <TextView
                android:id="@+id/input_password_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/password_label"
                android:textSize="14sp"
                android:textColor="@color/text_input_label_selector"
                android:fontFamily="@font/semibold"/>
            <EditText
                android:id="@+id/input_password_value"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/disable"
                style="@style/InputBottom"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/password_hint1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password_hint1"
                    android:textColor="@color/text_input_hint_selector"
                    android:textSize="10sp"
                    android:layout_marginLeft="5dp"/>

                <TextView
                    android:id="@+id/password_hint2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password_hint2"
                    android:textColor="@color/text_input_hint_selector"
                    android:textSize="10sp"
                    android:layout_marginLeft="5dp"/>

                <TextView
                    android:id="@+id/password_hint3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password_hint3"
                    android:textColor="@color/text_input_hint_selector"
                    android:textSize="10sp"
                    android:layout_marginLeft="5dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/input_password_check_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/password_check_label"
                android:textSize="14sp"
                android:textColor="@color/text_input_label_selector"
                android:fontFamily="@font/semibold"
                android:layout_marginTop="20dp"/>
            <EditText
                android:id="@+id/input_password_check_value"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/disable"
                style="@style/InputBottom"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">
                <TextView
                    android:id="@+id/password_same_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password_check_hint1"
                    android:textColor="@color/text_input_hint_selector"
                    android:textSize="10sp"
                    android:layout_marginLeft="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/go_next_button"
        android:enabled="false"
        style="@style/MainButton"
        android:text="@string/next_button"
        android:layout_marginTop="20dp"
        />
</LinearLayout>